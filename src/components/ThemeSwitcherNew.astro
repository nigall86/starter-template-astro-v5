---
// libraries
import { Icon } from 'astro-icon/components';

import '@/styles/components/theme-switcher.css';
---

<label class="dm-toggle" for="dm-toggle-element">
  <span class="dm-toggle__label visually-hidden">Light mode</span>

  <input
    type="checkbox"
    role="switch"
    class="dm-toggle__element"
    id="dm-toggle-element"
  />

  <div class="dm-toggle__decor" aria-hidden="true">
    <div class="dm-toggle__thumb"></div>
    <Icon
      name="moon"
      size="1em"
      class="dm-toggle__icon"
      data-state="checked"
      focusable="false"
    />
    <Icon
      name="sun"
      size="1em"
      class="dm-toggle__icon"
      data-state="un-checked"
      focusable="false"
    />
  </div>
</label>

<script>
  const toggle = document.querySelector('.dm-toggle__element');
  const label = document.querySelector('.dm-toggle__label');

  toggle?.addEventListener('change', (e) => {
    if (e.target.checked) {
      label.textContent = 'Dark mode';
      return;
    } else {
      label.textContent = 'Light mode';
    }
  });

  // toggle.querySelector('input').addEventListener('change', (e) => {
  //   if (e.target.checked) {
  //     document.body.setAttribute('color-scheme', 'dark');
  //     return;
  //   }
  //   document.body.removeAttribute('dark');
  //   document.body.setAttribute('color-scheme', 'light');
  // });
  // }
</script>
