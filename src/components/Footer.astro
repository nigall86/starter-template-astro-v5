---
// components
import Logo from '@/components/Logo.astro';
import Link from '@/components/ui/links/Link.astro';
import SocialIcons from './SocialIcons.astro';

// data
import { footerLinks } from '@/data/footerData.ts';
---

<footer class="site-footer">
  <div class="content-grid">
    <div class="site-footer__inner">
      <Logo type="footer" />
      <ul class="site-footer__list">
        {
          footerLinks.map((item) => (
            <li>
              <Link text={item.name} href={item.path} />
            </li>
          ))
        }
      </ul>
      <SocialIcons size={40} />
    </div>
    <div>
      <small class="date">
        Copyright &copy;<span id="copyright"
          >{new Date().getFullYear()}</span
        > | All rights reserved.
      </small>
    </div>
  </div>
</footer>

<!-- Styles -->
<style>
  .site-footer {
    /* Spacing */
    --flex-gap: var(--space-l);
    --_footer-padding-block: var(--space-l);

    /* Background */
    --_footer-bg: var(--surface-2, var(--bgColor-default));

    /* Text */
    --_footer-font-family: var(--ff-base);
    --_footer-font-weight: var(--fw-regular);
    --_footer-link: var(--text-1, var(--fgColor-default));
    --_footer-link-hover: var(
      --link-hover,
      var(--fgColor-onEmphasis)
    );
    --_footer-letter-spacing: var(--letter-spacing-0);

    padding-block: var(--_footer-padding-block);
    background-color: var(--_footer-bg);
    color: var(--_footer-link);

    &__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--flex-gap);
    }

    &__list {
      flex-grow: 1;

      display: flex;
      list-style: none;
      justify-content: space-evenly;

      a {
        font-family: var(--_footer-font-family);
        font-size: var(--fs-sm);
        font-weight: var(--_footer-font-weight);
        color: var(--_footer-link);
        letter-spacing: var(--_footer-letter-spacing);
        text-decoration: none;

        &:is(:hover, :focus) {
          color: var(--_footer-link-hover);
        }
      }
    }

    .date {
      display: inline-block;
      margin-block-start: var(--space-s);
      color: var(--text-2, var(--fgColor-muted));
      font-size: var(--fs-2xs);
    }
  }
</style>

<!-- Script -->
<script>
  // Set actual year in the footer
  const copyrightSpan = document.getElementById(
    'copyright',
  ) as HTMLSpanElement;
  copyrightSpan.textContent = new Date().getFullYear().toString();
</script>
