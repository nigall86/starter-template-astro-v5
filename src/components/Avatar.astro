---
// astro tools
import { Image } from 'astro:assets';

interface Props {
  src: string;
  altText: string;
  size?: number;
}
const { src, altText, size = 100 } = Astro.props;
---

<Image
  class="avatar"
  src={src}
  alt={altText}
  width={size}
  height={size}
/>

<style is:global>
  .avatar {
    border-radius: 100%;
    border: 0.25em solid var(--surface-1, var(--borderColor-default));
    aspect-ratio: 1/1;
    object-fit: cover;
    transition: scale 0.3s ease;

    &:hover {
      scale: 1.3;
    }
  }
</style>
