---
// Assets
import IconLogo from '../icons/logo.svg';

interface Props {
  type?: 'header' | 'footer';
  size?: number;
  title?: string;
}

const {
  type,
  size = 40,
  title = 'Logo of the company',
} = Astro.props;
---

<a class="logo" href="/" title={title} data-astro-reload>
  <IconLogo width={size} height={size} data-type={type} />
</a>

<style>
  .logo {
    --_logo-color-header: var(--brand, var(--fgColor-brand));
    --_logo-color-footer: var(--brand, var(--fgColor-brand));

    padding-inline: var(--size-5);

    > svg {
      &[data-type='header'] {
        fill: var(--_logo-color-header);
      }

      &[data-type='footer'] {
        fill: var(--_logo-color-footer);
      }
    }
  }
</style>
