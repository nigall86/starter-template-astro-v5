---
// Assets
import IconLogo from '../icons/logo.svg';

interface Props {
  type?: 'header' | 'footer';
  size?: number;
  title?: string;
}

const {
  type,
  size = 40,
  title = 'Logo of the company',
} = Astro.props;
---

<a
  class="logo"
  href="/"
  title={title}
  data-type={type}
  data-astro-reload
>
  <IconLogo width={size} height={size} />
</a>

<style>
  .logo {
    --_logo-color-header: var(--brand, var(--fgColor-brand));
    --_logo-color-footer: var(--brand, var(--fgColor-brand));

    &[data-type='header'] {
      padding-inline: var(--space-s);

      > svg {
        fill: var(--_logo-color-header);
      }
    }

    &[data-type='footer'] > svg {
      fill: var(--_logo-color-footer);
    }
  }
</style>
